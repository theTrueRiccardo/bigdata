# Routes
# This file defines all application routes (Higher priority routes first)
# https://www.playframework.com/documentation/latest/ScalaRouting
# ~~~~

# An example controller showing a sample home page
GET     /                           controllers.HomeController.index()

# Map static resources from the /public folder to the /assets URL path
GET     /assets/*file               controllers.Assets.versioned(path="/public", file: Asset)

GET     /query                      controllers.SparkController.eseguiQuery

GET     /taxi                       controllers.SparkController.contaTaxi

GET     /mattia                     controllers.SparkController.mattia

GET     /orario/:inizio/:fine       controllers.SparkController.orario(inizio : Double , fine : Double)

GET     /area/:inizioLong/:fineLong/:inizioLat/:fineLat      controllers.SparkController.area(inizioLong: Double ,fineLong : Double, inizioLat :   Double , fineLat: Double) 

GET     /confrontoGiornoNotte/:id   controllers.SparkController.confrontoGiornoNotte(id : Int)

#GET     /doppioni/:id               controllers.SparkController.listaDoppioni(id : Int)

GET     /schedaTaxi/:id             controllers.SparkController.schedaTaxi(id : Int)
